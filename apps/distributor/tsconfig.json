{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@app/*": ["./app/*"],
      "@components/*": ["./components/*"],
      "@features/*": ["./features/*"],
      "@platform/*": ["../../lib/*"],
      "@styles/*": ["../../styles/*"],
      "@shared/*": ["../../packages/shared/*"],
      "@shared-ui/*": ["../../packages/shared-ui/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
